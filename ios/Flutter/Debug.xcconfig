#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
// Apple Silicon simulator workaround: Xcode 27 lipo rejects Flutter 3.41's
// multi-architecture verification. Keep arm64 literal: NATIVE_ARCH_ACTUAL
// prevents Xcode from resolving simulator destinations. Intel Macs need x86_64.
ARCHS[sdk=iphonesimulator*] = arm64
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
